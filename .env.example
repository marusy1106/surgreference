# Скопируйте в .env и заполните. Файл .env не коммитится.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

DATABASE_URL=postgres://surgreference:surgreference@localhost:5432/surgreference
REDIS_URL=redis://localhost:6379/0

# S3-совместимое хранилище (локально — MinIO из docker compose; пусто — файловая система)
S3_BUCKET=
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Почта (локально — Mailpit, веб-интерфейс http://localhost:8025)
EMAIL_URL=smtp://localhost:1025
# Локально без воркера Celery: true — письма уходят сразу (с consolemail:// печатаются в консоль сервера).
CELERY_TASK_ALWAYS_EAGER=false
DEFAULT_FROM_EMAIL=SurgReference <no-reply@surgreference.local>

MIN_APP_VERSION=1.0.0
API_DOCS_ENABLED=true

# Ключи подписи access-токенов (в dev можно не задавать — используется DJANGO_SECRET_KEY).
# Формат: kid=секрет через запятую; активный ключ — JWT_ACTIVE_KID. Генерация: openssl rand -base64 48
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=
# Число доверенных обратных прокси перед приложением (для определения IP клиента).
NUM_PROXIES=0
